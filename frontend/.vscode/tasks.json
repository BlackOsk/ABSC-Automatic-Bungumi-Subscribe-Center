{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Frontend Dev Server",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      // 告诉 VS Code 看到这段日志就代表前端启动成功了
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": { "regexp": "^.*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "ready in.*|Local:"
        }
      }
    }
  ]
}