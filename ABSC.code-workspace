{
  "folders": [
    {
      "name": "📂 PROJECT-ROOT",
      "path": "."
    },
    {
      "name": "🐹 BACKEND (Go)",
      "path": "backend"
    },
    {
      "name": "⚛️ FRONTEND (React)",
      "path": "frontend"
    }
  ],
  "settings": {
    // 强制前后端使用各自的格式化工具
    "[go]": {
      "editor.defaultFormatter": "golang.go",
      "editor.formatOnSave": true
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    // 隐藏多余的嵌套文件夹，保持侧边栏清爽
    "files.exclude": {
      "backend": true,
      "frontend": true,
      "**/node_modules": true,
      "**/.git": true
    },

    // 修改测试面板的全局超时时间为 5 分钟
    "go.testTimeout": "5m",

    // 让左侧测试面板在运行时，也能无缝注入开发环境变量
    "go.testEnvVars": {
      //"APP_ENV": "development",
      //"TMDB_API_KEY": "你的TMDB密钥（可选，也可以写在系统变量里）",
      //"HTTP_PROXY": "http://127.0.0.1:7890",
      //"HTTPS_PROXY": "http://127.0.0.1:7890"
    }
  }
}

